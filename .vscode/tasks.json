			"type": "shell",
			"command": "node.exe",
			"args": [
				"-e",
				"require('net').connect(27017,'127.0.0.1').on('connect',()=>{console.log('MongoDB port 27017 is reachable');process.exit(0)}).on('error',()=>{console.log('MongoDB port 27017 is not reachable');process.exit(0)})"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Test configured MongoDB connection",
			"type": "shell",
			"command": "node.exe",
			"args": [
				"-e",
				"require('./backend/node_modules/dotenv').config({path:'backend/.env'}); const mongoose=require('./backend/node_modules/mongoose'); mongoose.connect(process.env.MONGO_URI,{serverSelectionTimeoutMS:8000}).then(async()=>{console.log('MongoDB connection OK'); await mongoose.disconnect();}).catch(error=>{console.log('MongoDB connection failed:',error.name,error.message.replace(/mongodb(?:\\+srv)?:\\/\\/[^\\s]+/gi,'[redacted connection string]'));process.exitCode=1;});"
			],
			"isBackground": false,
			"problemMatcher": []

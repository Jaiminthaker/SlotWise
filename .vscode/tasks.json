		{
			"label": "Check SlotWise API health",
			"type": "shell",
			"command": "node.exe",
			"args": [
				"-e",
				"let attempts=0; const check=async()=>{try{const response=await fetch('http://127.0.0.1:5000/api/health'); console.log('API health:',response.status,await response.text()); process.exit(response.ok?0:1);}catch(error){if(++attempts<10){setTimeout(check,500);return;} console.log('API not reachable:',error.cause?.code||error.message); process.exit(1);}}; check();"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Verify API health cleanly",
			"type": "shell",
			"command": "node.exe",
			"args": [
				"-e",
				"fetch('http://127.0.0.1:5000/api/health').then(async response=>console.log('API health:',response.status,await response.text())).catch(error=>{console.error('API health request failed:',error.cause?.code||error.message); process.exitCode=1;});"
			],
			"isBackground": false,
